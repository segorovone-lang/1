import java.util.concurrent.Semaphore;

/**
 * A Semaphore that never allows the number of available permits
 * to exceed the initial maximum. Any release attempt that would
 * go over the limit is silently capped.
 */
public class SafeReleaseSemaphore extends Semaphore {
    private final int maxPermits;

    public SafeReleaseSemaphore(int permits) {
        super(permits);
        this.maxPermits = permits;
    }

    public SafeReleaseSemaphore(int permits, boolean fair) {
        super(permits, fair);
        this.maxPermits = permits;
    }

    /**
     * Releases a single permit, capped to the maximum allowed.
     */
    @Override
    public void release() {
        release(1);
    }

    /**
     * Releases permits up to the maximum. If the requested number
     * would exceed the cap, only the remaining capacity is released.
     *
     * @param permits requested permits to release (non‑negative)
     */
    @Override
    public void release(int permits) {
        if (permits < 0) {
            throw new IllegalArgumentException("permits must be non-negative");
        }
        // Atomic check‑and‑act to avoid race conditions
        synchronized (this) {
            int available = super.availablePermits();
            int allowed = Math.min(permits, maxPermits - available);
            if (allowed > 0) {
                super.release(allowed);
            }
            // If allowed == 0, do nothing – we are already at capacity.
        }
    }

    public int getMaxPermits() {
        return maxPermits;
    }
}
