@Data
@Builder
public class CalculationResult {
    private Long taskId;
    private Long productInstanceId;
    private List<BaseRateDto> baseRates;      // 1-2 элемента
    private List<SurchargeDto> surcharges;    // 4-5 элементов
    private List<FinalRateDto> finalRates;    // 5-10 элементов
    private BigDecimal finalRate;
    private String newHash;
    private boolean performed;                // true – данные изменились
    private boolean failed;                   // true – ошибка при расчёте

    public static CalculationResult failed(Long taskId) {
        return CalculationResult.builder().taskId(taskId).failed(true).build();
    }
}

