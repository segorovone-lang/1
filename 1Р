package com.example.rates.service;

import com.example.rates.model.Allowance;
import com.example.rates.model.Rate;
import com.example.rates.model.TariffOption;

import java.time.LocalDate;
import java.util.*;
import java.util.concurrent.atomic.AtomicLong;

public class RateSplitter {

    private final AtomicLong idGen = new AtomicLong(1);

    /**
     * Основной метод расчёта.
     *
     * @param existingRates существующие ставки (будут модифицированы + дополнены новыми)
     * @param tariffOptions список TariffOption
     * @param allowances    список Allowance
     * @return итоговый список ставок (тот же список existingRates, но с новыми записями)
     */
    public List<Rate> calculate(
            List<Rate> existingRates,
            List<TariffOption> tariffOptions,
            List<Allowance> allowances
    ) {
        // Используем ArrayList, чтобы можно было добавлять записи
        List<Rate> rates = new ArrayList<>(existingRates);

        // 1. Собираем все точки разбиения
        Set<LocalDate> splitPoints = collectAllSplitPoints(tariffOptions, allowances);

        // 2. Гарантируем непрерывное покрытие для всех TO и Allowance
        for (TariffOption to : tariffOptions) {
            ensureContinuousCoverage(rates, to.beginDate(), to.endDate());
        }
        for (Allowance allowance : allowances) {
            ensureContinuousCoverage(rates, allowance.beginDate(), allowance.endDate());
        }

        // 3. Применяем все точки разбиения (отсортированы по возрастанию)
        for (LocalDate point : splitPoints) {
            splitAt(rates, point);
        }

        // 4. Сортируем финальный результат
        rates.sort(Comparator.comparing(Rate::getBeginDate));

        // Возвращаем тот же список, что и входной existingRates (он мутировал)
        existingRates.clear();
        existingRates.addAll(rates);
        return existingRates;
    }

    /**
     * Собирает все точки разбиения из всех TO и Allowance.
     */
    private Set<LocalDate> collectAllSplitPoints(
            List<TariffOption> tariffOptions,
            List<Allowance> allowances
    ) {
        Set<LocalDate> points = new TreeSet<>();

        for (TariffOption to : tariffOptions) {
            points.add(to.beginDate());
            points.add(to.endDate().plusDays(1));
            if (to.updateDate() != null) {
                points.add(to.updateDate());
            }
        }

        for (Allowance allowance : allowances) {
            points.add(allowance.beginDate());
            points.add(allowance.endDate().plusDays(1));
        }

        return points;
    }

    /**
     * Разбиение одной записи в точке splitPoint.
     * Работает напрямую со списком rates.
     */
    private void splitAt(List<Rate> rates, LocalDate splitPoint) {
        Rate found = findCovering(rates, splitPoint);
        if (found == null) return;

        if (found.getBeginDate().equals(splitPoint)) return;
        if (splitPoint.isBefore(found.getBeginDate()) || splitPoint.isAfter(found.getEndDate())) {
            return;
        }

        LocalDate originalEnd = found.getEndDate();
        found.setEndDate(splitPoint.minusDays(1));

        Rate newRate = new Rate(nextId(), splitPoint, originalEnd);
        rates.add(newRate);
    }

    /**
     * Гарантирует непрерывное покрытие периода [from, to].
     */
    private void ensureContinuousCoverage(List<Rate> rates, LocalDate from, LocalDate to) {
        List<Rate> overlapping = findOverlapping(rates, from, to);

        // Случай 1: нет пересекающихся ставок — создаём одну новую
        if (overlapping.isEmpty()) {
            rates.add(new Rate(nextId(), from, to));
            return;
        }

        overlapping.sort(Comparator.comparing(Rate::getBeginDate));

        // Случай 2: расширяем первую ставку назад
        Rate first = overlapping.get(0);
        if (first.getBeginDate().isAfter(from)) {
            first.setBeginDate(from);
        }

        // Случай 3: расширяем последнюю ставку вперёд
        Rate last = overlapping.get(overlapping.size() - 1);
        if (last.getEndDate().isBefore(to)) {
            last.setEndDate(to);
        }

        // Случай 4: заполняем дыры между соседними ставками
        for (int i = 0; i < overlapping.size() - 1; i++) {
            Rate current = overlapping.get(i);
            Rate next = overlapping.get(i + 1);

            LocalDate gapStart = current.getEndDate().plusDays(1);
            LocalDate gapEnd = next.getBeginDate().minusDays(1);

            if (!gapStart.isAfter(gapEnd)) {
                rates.add(new Rate(nextId(), gapStart, gapEnd));
            }
        }
    }

    // ===== Вспомогательные методы для работы со списками =====

    private Rate findCovering(List<Rate> rates, LocalDate date) {
        for (Rate r : rates) {
            if (r.covers(date)) return r;
        }
        return null;
    }

    private List<Rate> findOverlapping(List<Rate> rates, LocalDate from, LocalDate to) {
        List<Rate> result = new ArrayList<>();
        for (Rate r : rates) {
            if (r.overlaps(from, to)) result.add(r);
        }
        return result;
    }

    private Long nextId() {
        return idGen.getAndIncrement();
    }
}
