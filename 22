import java.time.LocalDate;
import java.util.*;

public record DateRangeDto(LocalDate startDate, LocalDate endDate) {
    public DateRangeDto {
        Objects.requireNonNull(startDate, "startDate must not be null");
        // endDate может быть null (бесконечность)
    }
}

public class IntervalExchangeService {

    /**
     * Разбивает основной диапазон {@code rateArrangementDateRange} на интервалы
     * с учётом начал и окончаний переданных сегментов {@code segmentRateRanges}.
     *
     * @param rateArrangementDateRange основной диапазон (не null)
     * @param segmentRateRanges        список сегментов (не null, не содержит null-элементов)
     * @return список непересекающихся интервалов, покрывающих основной диапазон
     * @throws NullPointerException если любой из параметров null или список содержит null
     */
    public List<DateRangeDto> exchangeIntervals(DateRangeDto rateArrangementDateRange,
                                                 List<DateRangeDto> segmentRateRanges) {
        Objects.requireNonNull(rateArrangementDateRange, "rateArrangementDateRange must not be null");
        Objects.requireNonNull(segmentRateRanges, "segmentRateRanges must not be null");

        LocalDate mainStart = rateArrangementDateRange.startDate();
        LocalDate mainEnd = rateArrangementDateRange.endDate(); // может быть null

        NavigableSet<LocalDate> splitPoints = new TreeSet<>();
        splitPoints.add(mainStart);

        for (DateRangeDto seg : segmentRateRanges) {
            Objects.requireNonNull(seg, "segmentRateRanges contains null element");

            LocalDate segStart = seg.startDate();
            LocalDate segEnd = seg.endDate();

            // Корректируем начало: не раньше основного старта
            if (segStart.isBefore(mainStart)) {
                segStart = mainStart;
            }

            // Корректируем конец: если mainEnd задан, а segEnd выходит за границу
            if (mainEnd != null) {
                if (segEnd == null || segEnd.isAfter(mainEnd)) {
                    segEnd = mainEnd;
                }
            }

            // Игнорируем вырожденный сегмент
            if (segEnd != null && segStart.isAfter(segEnd)) {
                continue;
            }

            // Точка разбиения: начало сегмента (если внутри)
            if (segStart.isAfter(mainStart)) {
                splitPoints.add(segStart);
            }

            // Точка разбиения: день после окончания (если окончание есть и точка внутри)
            if (segEnd != null) {
                LocalDate dayAfterEnd = segEnd.plusDays(1);
                if (mainEnd == null || !dayAfterEnd.isAfter(mainEnd)) {
                    splitPoints.add(dayAfterEnd);
                }
            }
        }

        // Формируем интервалы
        List<LocalDate> points = new ArrayList<>(splitPoints);
        List<DateRangeDto> result = new ArrayList<>();

        for (int i = 0; i < points.size(); i++) {
            LocalDate intervalStart = points.get(i);
            LocalDate intervalEnd;

            if (i < points.size() - 1) {
                intervalEnd = points.get(i + 1).minusDays(1);
            } else {
                intervalEnd = mainEnd; // может быть null
            }

            // Пропускаем вырожденные интервалы (start > end)
            if (intervalEnd != null && intervalStart.isAfter(intervalEnd)) {
                continue;
            }

            result.add(new DateRangeDto(intervalStart, intervalEnd));
        }

        return result;
    }
}
