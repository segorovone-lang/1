import java.time.LocalDate;
import java.util.ArrayList;
import java.util.HashSet;
import java.util.List;
import java.util.Set;

public record DateRangeDto(LocalDate startDate, LocalDate endDate) {}

public class DateRangeProcessor {

    public List<DateRangeDto> exchangeIntervals(DateRangeDto rateArrangementDateRange, List<DateRangeDto> segmentRateRanges) {
        LocalDate mainStart = rateArrangementDateRange.startDate();
        LocalDate mainEnd = rateArrangementDateRange.endDate();

        // Защита от некорректного входного диапазона
        if (mainStart == null) {
            return List.of();
        }

        Set<LocalDate> cutPoints = new HashSet<>();
        cutPoints.add(mainStart);

        if (segmentRateRanges != null) {
            for (DateRangeDto seg : segmentRateRanges) {
                // Безопасное получение дат сегмента
                LocalDate segStart = seg.startDate() != null ? seg.startDate() : mainStart;
                LocalDate segEnd = seg.endDate();

                // 1. Находим начало пересечения
                LocalDate overlapStart = segStart.isBefore(mainStart) ? mainStart : segStart;

                // 2. Находим конец пересечения (учитываем null как бесконечность)
                LocalDate overlapEnd;
                if (mainEnd == null) {
                    overlapEnd = segEnd;
                } else if (segEnd == null) {
                    overlapEnd = mainEnd;
                } else {
                    overlapEnd = segEnd.isBefore(mainEnd) ? segEnd : mainEnd;
                }

                // 3. Проверяем, есть ли реальное пересечение
                boolean hasOverlap = (overlapEnd == null) || !overlapStart.isAfter(overlapEnd);
                if (!hasOverlap) {
                    continue;
                }

                // 4. Добавляем точки разрыва
                cutPoints.add(overlapStart);
                if (overlapEnd != null) {
                    cutPoints.add(overlapEnd.plusDays(1));
                }
            }
        }

        // 5. Фильтруем, оставляем только точки внутри основного диапазона, и сортируем
        List<LocalDate> sortedPoints = cutPoints.stream()
                .filter(p -> !p.isBefore(mainStart))
                .filter(p -> mainEnd == null || !p.isAfter(mainEnd))
                .sorted()
                .toList();

        // 6. Формируем итоговые интервалы
        List<DateRangeDto> result = new ArrayList<>();
        for (int i = 0; i < sortedPoints.size(); i++) {
            LocalDate start = sortedPoints.get(i);
            LocalDate end = (i < sortedPoints.size() - 1) ? sortedPoints.get(i + 1).minusDays(1) : mainEnd;

            // 🔒 Финальная защита от некорректных интервалов (start > end)
            if (end == null || !start.isAfter(end)) {
                result.add(new DateRangeDto(start, end));
            }
        }

        return result;
    }
}
