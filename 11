import java.time.LocalDate;
import java.util.ArrayList;
import java.util.List;
import java.util.TreeSet;
import java.util.stream.Collectors;

public record DateRangeDto(LocalDate startDate, LocalDate endDate) {}

public class DateRangeProcessor {

    /**
     * Разбивает основной диапазон на части, учитывая пересечения с сегментами.
     * Если основной диапазон пересекается с сегментами, он "разрезается" по их границам.
     * null в endDate означает бесконечность.
     */
    public List<DateRangeDto> exchangeIntervals(DateRangeDto rateArrangementDateRange, List<DateRangeDto> segmentRateRanges) {
        LocalDate mainStart = rateArrangementDateRange.startDate();
        LocalDate mainEnd = rateArrangementDateRange.endDate();

        // TreeSet автоматически сортирует даты и убирает дубликаты
        TreeSet<LocalDate> boundaries = new TreeSet<>();
        boundaries.add(mainStart);

        if (segmentRateRanges != null) {
            for (var segment : segmentRateRanges) {
                processSegment(mainStart, mainEnd, segment, boundaries);
            }
        }

        // Оставляем только точки-начала интервалов, которые попадают в основной диапазон
        List<LocalDate> points = boundaries.stream()
                .filter(d -> !d.isBefore(mainStart) && (mainEnd == null || !d.isAfter(mainEnd)))
                .collect(Collectors.toList());

        List<DateRangeDto> result = new ArrayList<>();
        for (int i = 0; i < points.size(); i++) {
            LocalDate start = points.get(i);
            // Конец текущего интервала = начало следующего - 1 день, 
            // либо конец основного диапазона (для последнего элемента)
            LocalDate end = (i < points.size() - 1) ? points.get(i + 1).minusDays(1) : mainEnd;

            // Защита от вырожденных интервалов (start > end)
            if (!start.isAfter(end)) {
                result.add(new DateRangeDto(start, end));
            }
        }

        return result;
    }

    private void processSegment(LocalDate mainStart, LocalDate mainEnd, 
                                DateRangeDto segment, TreeSet<LocalDate> boundaries) {
        LocalDate segStart = segment.startDate();
        LocalDate segEnd = segment.endDate();

        // 1. Находим начало пересечения
        LocalDate overlapStart = segStart.isBefore(mainStart) ? mainStart : segStart;

        // 2. Находим конец пересечения
        LocalDate overlapEnd;
        if (mainEnd == null) {
            overlapEnd = segEnd;
        } else if (segEnd == null) {
            overlapEnd = mainEnd;
        } else {
            overlapEnd = segEnd.isBefore(mainEnd) ? segEnd : mainEnd;
        }

        // 3. Если пересечения нет, пропускаем сегмент
        if (overlapStart.isAfter(overlapEnd)) {
            return;
        }

        // 4. Добавляем границы пересечения в набор точек разбиения
        boundaries.add(overlapStart);
        if (overlapEnd != null) {
            // Следующий день после конца пересечения становится началом нового интервала
            boundaries.add(overlapEnd.plusDays(1));
        }
    }

    // Пример использования, точно соответствующий вашему условию
    public static void main(String[] args) {
        DateRangeProcessor processor = new DateRangeProcessor();

        var mainRange = new DateRangeDto(LocalDate.of(2026, 5, 20), null);
        var segments = List.of(
            new DateRangeDto(LocalDate.of(2026, 4, 4), null),
            new DateRangeDto(LocalDate.of(2026, 5, 1), LocalDate.of(2026, 5, 31)),
            new DateRangeDto(LocalDate.of(2026, 5, 21), null)
        );

        var result = processor.exchangeIntervals(mainRange, segments);

        System.out.println("Итоговые интервалы:");
        result.forEach(r -> System.out.printf("с %s по %s%n", 
            r.startDate(), r.endDate() == null ? "null (бесконечность)" : r.endDate()));
    }
}
