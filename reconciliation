 SELECT t.task_id, t.product_id, t.base_amount, t.created_at, t.status,
                   t.retry_count, t.last_retried_at, t.max_retries
            FROM task_registry t
            LEFT JOIN task_results r ON t.task_id = r.task_id
            WHERE t.created_at >= :since
              AND r.task_id IS NULL
              AND t.retry_count < t.max_retries
              AND (
                  t.last_retried_at IS NULL 
                  OR t.last_retried_at <= :retryThreshold
              )
            ORDER BY t.created_at ASC
            LIMIT 10000
