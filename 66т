import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.DisplayName;
import java.time.LocalDate;
import java.util.List;

import static org.junit.jupiter.api.Assertions.*;

class IntervalExchangeServiceTest {

    private final IntervalExchangeService service = new IntervalExchangeService();

    @Test
    @DisplayName("Пример из условия: main 20.05-∞, segments (04.04-∞), (01.05-31.05), (21.05-∞)")
    void baseExample() {
        DateRangeDto main = new DateRangeDto(LocalDate.of(2026, 5, 20), null);
        List<DateRangeDto> seg = List.of(
                new DateRangeDto(LocalDate.of(2026, 4, 4), null),
                new DateRangeDto(LocalDate.of(2026, 5, 1), LocalDate.of(2026, 5, 31)),
                new DateRangeDto(LocalDate.of(2026, 5, 21), null)
        );
        List<DateRangeDto> res = service.exchangeIntervals(main, seg);
        assertEquals(3, res.size());
        assertEquals(new DateRangeDto(LocalDate.of(2026, 5, 20), LocalDate.of(2026, 5, 20)), res.get(0));
        assertEquals(new DateRangeDto(LocalDate.of(2026, 5, 21), LocalDate.of(2026, 5, 31)), res.get(1));
        assertEquals(new DateRangeDto(LocalDate.of(2026, 6, 1), null), res.get(2));
    }

    @Test
    @DisplayName("Усложнённый кейс: пересечение с началом в середине месяца (25.05)")
    void midMonthOverlap() {
        DateRangeDto main = new DateRangeDto(LocalDate.of(2026, 5, 20), LocalDate.of(2026, 11, 30));
        List<DateRangeDto> seg = List.of(
                new DateRangeDto(LocalDate.of(2026, 5, 20), LocalDate.of(2026, 5, 30)),
                new DateRangeDto(LocalDate.of(2026, 5, 25), LocalDate.of(2026, 11, 30))
        );
        List<DateRangeDto> res = service.exchangeIntervals(main, seg);
        assertEquals(3, res.size());
        assertEquals(new DateRangeDto(LocalDate.of(2026, 5, 20), LocalDate.of(2026, 5, 24)), res.get(0));
        assertEquals(new DateRangeDto(LocalDate.of(2026, 5, 25), LocalDate.of(2026, 5, 31)), res.get(1));
        assertEquals(new DateRangeDto(LocalDate.of(2026, 6, 1), LocalDate.of(2026, 11, 30)), res.get(2));
    }

    @Test
    @DisplayName("Начало приоритетного сегмента ровно в последний день месяца (31.05)")
    void lastDayStart() {
        DateRangeDto main = new DateRangeDto(LocalDate.of(2026, 5, 20), LocalDate.of(2026, 11, 30));
        List<DateRangeDto> seg = List.of(
                new DateRangeDto(LocalDate.of(2026, 5, 20), LocalDate.of(2026, 5, 30)),
                new DateRangeDto(LocalDate.of(2026, 5, 31), LocalDate.of(2026, 11, 30))
        );
        List<DateRangeDto> res = service.exchangeIntervals(main, seg);
        assertEquals(3, res.size());
        assertEquals(new DateRangeDto(LocalDate.of(2026, 5, 20), LocalDate.of(2026, 5, 30)), res.get(0));
        assertEquals(new DateRangeDto(LocalDate.of(2026, 5, 31), LocalDate.of(2026, 5, 31)), res.get(1));
        assertEquals(new DateRangeDto(LocalDate.of(2026, 6, 1), LocalDate.of(2026, 11, 30)), res.get(2));
    }

    @Test
    @DisplayName("Интервал полностью внутри одного месяца не разбивается")
    void intervalInsideSingleMonth() {
        DateRangeDto main = new DateRangeDto(LocalDate.of(2026, 3, 1), LocalDate.of(2026, 3, 31));
        List<DateRangeDto> seg = List.of(
                new DateRangeDto(LocalDate.of(2026, 3, 10), LocalDate.of(2026, 3, 20))
        );
        List<DateRangeDto> res = service.exchangeIntervals(main, seg);
        assertEquals(3, res.size()); // mainStart..9, 10..20, 21..mainEnd
        // порядок хронологический
        assertTrue(res.get(1).startDate().equals(LocalDate.of(2026, 3, 10)) &&
                   res.get(1).endDate().equals(LocalDate.of(2026, 3, 20)));
    }

    @Test
    @DisplayName("NPE при null-параметрах")
    void nullSafety() {
        assertThrows(NullPointerException.class, () -> service.exchangeIntervals(null, List.of()));
        assertThrows(NullPointerException.class, () -> service.exchangeIntervals(new DateRangeDto(LocalDate.now(), null), null));
        List<DateRangeDto> withNull = new ArrayList<>();
        withNull.add(null);
        assertThrows(NullPointerException.class, () -> service.exchangeIntervals(new DateRangeDto(LocalDate.now(), null), withNull));
    }
}
